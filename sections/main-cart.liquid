<section class="cart">
  <h1>Cart</h1>

  {%- if cart.item_count == 0 -%}
    <p>Your cart is empty. <a href="{{ routes.all_products_collection_url }}">Continue shopping</a></p>
  {%- else -%}
    {%- form 'cart', cart -%}
      <table class="cart__table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Quantity</th>
            <th>Price</th>
          </tr>
        </thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <a href="{{ item.url }}">{{ item.product.title }}</a>
                {%- if item.variant.title != 'Default Title' -%}
                  <br />
                  <small>{{ item.variant.title }}</small>
                {%- endif -%}
              </td>
              <td>
                <input
                  type="number"
                  name="updates[]"
                  value="{{ item.quantity }}"
                  min="0"
                  aria-label="Quantity for {{ item.product.title | escape }}"
                />
              </td>
              <td>{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <p class="cart__total">Total: {{ cart.total_price | money }}</p>
      <button type="submit" name="checkout" class="btn btn--primary">Checkout</button>
    {%- endform -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": []
}
{% endschema %}
