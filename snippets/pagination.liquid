{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__prev">&laquo; Previous</a>
    {%- endif -%}

    <span class="pagination__info">
      Page {{ paginate.current_page }} of {{ paginate.pages }}
    </span>

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__next">Next &raquo;</a>
    {%- endif -%}
  </nav>
{%- endif -%}
